#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/openomada-agent
CONFIG=/etc/config/openomada

. /lib/functions.sh

start_service() {
	local enabled
	local host
	local site_id
	local device_name
	local device_mac
	local log_level
	local state_path
	local portal_engine
	local themespec_path
	local flush_conntrack

	config_load openomada
	config_get_bool enabled controller enabled 0
	[ "$enabled" = "1" ] || return 0
	[ -x "$PROG" ] || return 1

	config_get host controller host
	config_get site_id controller site_id
	config_get device_name device name
	config_get device_mac device mac
	config_get log_level agent log_level info
	config_get state_path agent state_path /var/lib/openomada/managed-state.json
	config_get portal_engine portal engine opennds
	config_get themespec_path portal themespec_path /usr/lib/opennds/theme_openomada_redirect.sh
	config_get_bool flush_conntrack portal flush_conntrack_on_deauth 1

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env OPENOMADA_CONFIG="$CONFIG"
	procd_set_param env OPENOMADA_CONTROLLER_HOST="$host"
	procd_set_param env OPENOMADA_SITE_ID="$site_id"
	procd_set_param env OPENOMADA_DEVICE_NAME="$device_name"
	procd_set_param env OPENOMADA_DEVICE_MAC="$device_mac"
	procd_set_param env OPENOMADA_LOG_LEVEL="$log_level"
	procd_set_param env OPENOMADA_STATE_PATH="$state_path"
	procd_set_param env OPENOMADA_PORTAL_ENGINE="$portal_engine"
	procd_set_param env OPENOMADA_OPENNDS_THEMESPEC_PATH="$themespec_path"
	procd_set_param env OPENOMADA_FLUSH_CONNTRACK_ON_DEAUTH="$flush_conntrack"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger openomada
}

reload_service() {
	restart
}
